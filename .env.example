# FalkorDB (Docker default shown; for FalkorDB Cloud use the host/port/password from the dashboard)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=0

# Optional. Without a key the agent uses a deterministic rule router and template answers.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
